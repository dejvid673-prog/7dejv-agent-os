{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://7dejv.local/schemas/skills-registry.schema.json",
  "title": "7DEJV Canonical Skills Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "status"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "path": {"type": "string", "pattern": "^skills/.+/SKILL\\.md$"},
          "status": {"const": "canonical"}
        }
      }
    }
  }
}
