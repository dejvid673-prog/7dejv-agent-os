{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://7dejv.local/schemas/workflows-registry.schema.json",
  "title": "7DEJV Canonical Workflows Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflows"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "status", "scope"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "path": {"type": "string", "pattern": "^workflows/.+\\.md$"},
          "status": {"const": "canonical"},
          "scope": {"enum": ["global", "domain", "repository-local"]}
        }
      }
    }
  }
}
