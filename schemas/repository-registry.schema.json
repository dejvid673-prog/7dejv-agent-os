{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://7dejv.local/schemas/repository-registry.schema.json",
  "title": "7DEJV Repository Registry",
  "type": "object",
  "required": ["schema_version", "snapshot_date", "owner", "repositories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "snapshot_date": {"type": "string", "format": "date"},
    "owner": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "visibility", "status", "classification", "default_branch"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "visibility": {"enum": ["public", "private", "internal"]},
          "status": {"enum": ["active", "review", "empty", "archived"]},
          "classification": {"enum": ["canonical-control-plane", "primary-migration-source", "product-or-domain-repository", "reference-low-signal", "empty"]},
          "default_branch": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
